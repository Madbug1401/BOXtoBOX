# Copia este ficheiro para .env.local (desenvolvimento) ou configura estas variáveis na Vercel.

# Palavra-passe do modo admin (obrigatória em produção)
ADMIN_PASSWORD=muda-isto

# Segredo para assinar a sessão do admin (string longa e aleatória).
# Gera uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Base de dados (Upstash Redis via Vercel Marketplace). A Vercel cria estas automaticamente.
# Aceita qualquer um dos pares:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Upload de imagens e vídeos (Vercel Blob). A Vercel cria esta automaticamente.
BLOB_READ_WRITE_TOKEN=

# Opcional: URL pública do site (para sitemap)
NEXT_PUBLIC_SITE_URL=https://boxtobox.vercel.app
